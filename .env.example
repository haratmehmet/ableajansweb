# ==========================================
# Able Ajans - Environment Variables Template
# ==========================================

# Database
# Use a pooled connection (e.g., Supabase Transaction pooler, PgBouncer) for Serverless environments like Vercel.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Storage Configuration
# Set to "local" for development, "vercel-blob" for production/Vercel.
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR="./public/uploads"

# Vercel Blob Token (Required if STORAGE_PROVIDER="vercel-blob")
BLOB_READ_WRITE_TOKEN="your_vercel_blob_token_here"

# Authentication
# Must be a secure, long random string in production!
JWT_SECRET="your_strong_jwt_secret_here"
