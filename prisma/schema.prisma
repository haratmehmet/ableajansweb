// prisma/schema.prisma
// Sprint 2+ için hazır — veritabanı bağlantısı ilerleyen sprintte eklenecek

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// CMS — Sayfa İçerikleri
// ─────────────────────────────────────────
model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  content     Json?    // Structured content blocks
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pages")
}

// ─────────────────────────────────────────
// Hizmetler
// ─────────────────────────────────────────
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  icon        String
  name        String
  description String
  order       Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

// ─────────────────────────────────────────
// Projeler
// ─────────────────────────────────────────
model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  category    String
  tags        String[]
  imageUrl    String?
  projectUrl  String?
  isVisible   Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  order       Int      @default(0)
  
  // SaaS/Premium Extensions
  statusBadge String   @default("Canlıda")
  problem     String?
  solution    String?
  features    Json?    // Array of strings
  gallery     Json?    // Array of strings
  results     Json?    // Array of { metric, label }

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

model ProjectsContent {
  id        Int      @id @default(autoincrement())
  section   String   @unique
  content   Json
  updatedAt DateTime @updatedAt
  @@map("projects_content")
}

// ─────────────────────────────────────────
// Ekip Üyeleri
// ─────────────────────────────────────────
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?
  photoUrl  String?
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

// ─────────────────────────────────────────
// Referanslar
// ─────────────────────────────────────────
model Reference {
  id          String   @id @default(cuid())
  name        String
  description String?
  logoUrl     String?
  websiteUrl  String?
  order       Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("references")
}

// ─────────────────────────────────────────
// İletişim Formları
// ─────────────────────────────────────────
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_submissions")
}

// ─────────────────────────────────────────
// Blog (Sprint 5)
// ─────────────────────────────────────────
model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String    // Markdown or rich text
  coverImage  String?
  tags        String[]
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  authorId    String?
  author      AdminUser? @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blog_posts")
}

// ─────────────────────────────────────────
// Medya (Vercel Blob — Sprint 7)
// ─────────────────────────────────────────
model Media {
  id         String   @id @default(cuid())
  filename   String
  url        String   // Vercel Blob URL
  contentType String
  sizeBytes  Int?
  alt        String?
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@map("media")
}

// ─────────────────────────────────────────
// Admin Kullanıcıları (Sprint 3)
// ─────────────────────────────────────────
model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  role         AdminRole  @default(EDITOR)
  isActive     Boolean    @default(true)
  blogPosts    BlogPost[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("admin_users")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

// ─────────────────────────────────────────
// Site Ayarları
// ─────────────────────────────────────────
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ─────────────────────────────────────────
// Yeni Eklenen İçerikler (Hero, Stat, Çözümler vb.)
// ─────────────────────────────────────────
model HeroContent {
  id          Int      @id @default(autoincrement())
  eyebrow     String   @default("Able Ajans Hoşgeldiniz")
  title       String
  titleAccent String   @default("Güçlü")
  titleLine2  String   @default("Varoluş Başladı")
  subtitle    String
  ctaText     String   @default("Bizi Arayın")
  ctaLink     String   @default("tel:+905458550089")
  ctaText2    String   @default("WhatsApp İletişim")
  ctaLink2    String   @default("https://wa.me/905458550089")
  socialStrip1 String  @default("Güvenilir Ajans")
  socialStrip2 String  @default("Premium Çözümler")
  socialStrip3 String  @default("Yenilikçi Yaklaşım")
  updatedAt   DateTime @updatedAt
  @@map("hero_content")
}

model StatCard {
  id        Int      @id @default(autoincrement())
  value     String
  label     String
  icon      String   @default("")
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  updatedAt DateTime @updatedAt
  @@map("stat_cards")
}

model SolutionItem {
  id          Int      @id @default(autoincrement())
  number      String
  icon        String
  title       String
  description String
  order       Int      @default(0)
  isVisible   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  @@map("solution_items")
}

model AboutContent {
  id        Int      @id @default(autoincrement())
  section   String   @unique
  content   Json
  updatedAt DateTime @updatedAt
  @@map("about_content")
}

model FooterContent {
  id        Int      @id @default(autoincrement())
  section   String   @unique
  content   Json
  updatedAt DateTime @updatedAt
  @@map("footer_content")
}
